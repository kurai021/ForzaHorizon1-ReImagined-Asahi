+bool VulkanCommandProcessor::IssueDrawMemexportCompute(VulkanShader* shader,
+    const PrimitiveProcessor::ProcessingResult& primitives, VkBuffer indices,
+    VkDeviceSize index_size, uint32_t index_base) {
+  auto modification = pipeline_cache_->GetCurrentVertexShaderModification(
+      *shader, Shader::HostVertexShaderType::kMemExportCompute, 0, false);
+  modification.vertex.compute_index_snapshot = true;
+  auto* translation = static_cast<VulkanShader::VulkanTranslation*>(
+      shader->GetOrCreateTranslation(modification.value));
+  if (!pipeline_cache_->EnsureShadersTranslated(translation, nullptr)) return false;
+  auto key = std::make_pair(shader->ucode_data_hash(), modification.value);
+  VkPipeline& pipeline = memexport_compute_pipelines_[key];
+  if (!pipeline) {
+    pipeline = ui::vulkan::util::CreateComputePipeline(GetVulkanDevice(),
+        current_guest_graphics_pipeline_layout_->GetPipelineLayout(),
+        translation->GetOrCreateShaderModule());
+    if (!pipeline) return false;
+  }
+
+  // Use immutable per-dispatch descriptors, reclaimed through the normal frame
+  // fence path. Updating the common set in-place would race earlier submissions.
+  VkDescriptorSet snapshot = AllocateSingleTransientDescriptor(SingleTransientDescriptorLayout::kMemexportCompute);
+  if (!snapshot) return false;
+  const auto* gpu = GetVulkanDevice();
+  const auto& f = gpu->functions();
+  VkCopyDescriptorSet copy{VK_STRUCTURE_TYPE_COPY_DESCRIPTOR_SET};
+  copy.srcSet = shared_memory_and_edram_descriptor_set_; copy.dstSet = snapshot;
+  copy.descriptorCount = 1u << SpirvShaderTranslator::GetSharedMemoryStorageBufferCountLog2(
+      gpu->properties().maxStorageBufferRange);
+  f.vkUpdateDescriptorSets(gpu->device(), 0, nullptr, 1, &copy);
+  VkDescriptorBufferInfo snapshot_info{indices ? indices : shared_memory_->buffer(), 0,
+                                      indices ? index_size : 4};
+  VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  write.dstSet = snapshot; write.dstBinding = 2; write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; write.pBufferInfo = &snapshot_info;
+  f.vkUpdateDescriptorSets(gpu->device(), 1, &write, 0, nullptr);
+
+  const auto saved_system = system_constants_;
+  auto initiator = register_file_->Get<reg::VGT_DRAW_INITIATOR>();
+  const bool dma = initiator.source_select == xenos::SourceSelect::kDMA;
+  system_constants_.flags &= ~(SpirvShaderTranslator::kSysFlag_VertexIndexLoad |
+      SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad |
+      SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit |
+      SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset);
+  if (dma) {
+    system_constants_.flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (initiator.index_size == xenos::IndexFormat::kInt32)
+      system_constants_.flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+    if (primitives.host_primitive_reset_enabled)
+      system_constants_.flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset;
+  }
+  system_constants_.compute_memexport_vertex_count = primitives.guest_draw_vertex_count;
+  system_constants_.vertex_index_load_address = index_base;
+  system_constants_.line_loop_closing_index = UINT32_MAX;
+  system_constants_.vertex_index_reset = register_file_->Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx;
+  system_constants_.vertex_index_endian = register_file_->Get<reg::VGT_DMA_SIZE>().swap_mode;
+  if (initiator.index_size == xenos::IndexFormat::kInt16 &&
+      system_constants_.vertex_index_endian != xenos::Endian::kNone &&
+      system_constants_.vertex_index_endian != xenos::Endian::k8in16)
+    system_constants_.vertex_index_endian = system_constants_.vertex_index_endian == xenos::Endian::k8in32
+        ? xenos::Endian::k8in16 : xenos::Endian::kNone;
+  current_constant_buffers_up_to_date_ &= ~(1u << SpirvShaderTranslator::kConstantBufferSystem);
+  if (!UpdateBindings(shader, nullptr)) {
+    system_constants_ = saved_system;
+    current_constant_buffers_up_to_date_ &= ~(1u << SpirvShaderTranslator::kConstantBufferSystem);
+    return false;
+  }
+  EndRenderPass();
+  // Rasterization has read the original inputs. Commit those reads before the
+  // compute side effects, then make writes visible to subsequent draws/copies.
+  uint32_t start = UINT32_MAX, end = 0;
+  for (const auto& range : memexport_ranges_) {
+    start = std::min(start, range.base_address_dwords << 2);
+    end = std::max(end, (range.base_address_dwords << 2) + range.size_bytes);
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kGuestDrawReadWrite,
+      start < end ? std::make_pair(start, end - start) : std::make_pair(0u, SharedMemory::kBufferSize));
+  SubmitBarriers(true);
+  BindExternalComputePipeline(pipeline);
+  VkDescriptorSet sets[]{snapshot, current_graphics_descriptor_sets_[SpirvShaderTranslator::kDescriptorSetConstants]};
+  deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+      current_guest_graphics_pipeline_layout_->GetPipelineLayout(), 0, 2, sets, 0, nullptr);
+  const uint32_t count = primitives.guest_draw_vertex_count;
+  if (count) deferred_command_buffer_.CmdVkDispatch(std::min(count, 65535u), (count + 65534u) / 65535u, 1);
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  system_constants_ = saved_system;
+  current_constant_buffers_up_to_date_ &= ~(1u << SpirvShaderTranslator::kConstantBufferSystem);
+  static uint32_t diagnostics = 0;
+  if (diagnostics++ < 32)
+    REXGPU_INFO("ASAHI memexport compute: shader={:016X}, vertices={}, DMA={}, snapshot={} bytes, after raster",
+                shader->ucode_data_hash(), count, dma, index_size);
+  return true;
+}
