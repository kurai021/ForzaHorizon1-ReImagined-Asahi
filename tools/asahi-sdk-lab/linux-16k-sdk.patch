diff --git a/include/rex/system/xmemory.h b/include/rex/system/xmemory.h
index 0c39a42..78850bb 100644
--- a/include/rex/system/xmemory.h
+++ b/include/rex/system/xmemory.h
@@ -37,10 +37,14 @@ namespace rex::memory::detail {
 ///   - Windows:        64KB granularity  -> offset
 ///   - macOS arm64:    16KB granularity  -> offset
 ///   - macOS x86_64:    4KB granularity  -> no offset
-///   - Linux (any):     4KB granularity  -> no offset (mmap handles it natively)
-constexpr u32 PhysicalHostOffset([[maybe_unused]] u32 guest_addr) noexcept {
+///   - Linux:          runtime page size -> offset only above 4KB
+inline u32 PhysicalHostOffset([[maybe_unused]] u32 guest_addr) noexcept {
 #if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && defined(__aarch64__))
   return (guest_addr >= 0xE0000000u) ? 0x1000u : 0u;
+#elif REX_PLATFORM_LINUX
+  if (guest_addr < 0xE0000000u) return 0u;
+  static const u32 offset = allocation_granularity() > 0x1000 ? 0x1000u : 0u;
+  return offset;
 #else
   return 0u;
 #endif
